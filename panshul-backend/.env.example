# App
APP_NAME=Panshul Education OS
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Used when DEBUG=false. The website itself proxies API calls server-side.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://panshul:panshul@localhost:5432/panshul
REDIS_URL=redis://localhost:6379/0

# OTP (console is for local development; use twilio in deployed environments)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=console            # console | twilio
# Twilio Verify v2 (all credentials stay in the backend environment)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# LLM (OpenAI-compatible endpoint)
# Option A — Groq free tier (no GPU needed): https://console.groq.com
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=qwen/qwen3-32b
# Option B — OpenRouter: https://openrouter.ai
#   LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=qwen/qwen3-32b:free
# Option C — self-hosted vLLM on a GPU box:
#   LLM_BASE_URL=http://localhost:8001/v1        LLM_MODEL=Qwen/Qwen3-14B
LLM_PROVIDER=qwen
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b
LLM_TIMEOUT_SECONDS=120

# YouTube Data API v3 (optional; keep the key backend-only)
YOUTUBE_API_KEY=

# Embeddings + vector store
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_MEMORY=student_memory
QDRANT_COLLECTION_CONTENT=learning_content

# Voice — 'sarvam' = API-based, no GPU (https://dashboard.sarvam.ai, free credits)
#         'faster_whisper' / 'xtts_v2' = self-hosted, needs GPU worker
STT_PROVIDER=sarvam
STT_MODEL=large-v3
TTS_PROVIDER=sarvam
TTS_MODEL_PATH=models/xtts_v2
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_STT_MODEL=saaras:v4

# Prompts
PROMPTS_DIR=prompts
