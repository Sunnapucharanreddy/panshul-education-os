# Copy to .env.production (ignored by Git) and replace every placeholder.
# Start with: docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
# Do not use these placeholders as live credentials.

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
BACKEND_URL=http://api:8000
# Leave blank when browsers use only the same-origin Next.js proxy. Otherwise set exact HTTPS origins.
CORS_ORIGINS=

ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-unique-random-secret

POSTGRES_DB=panshul
POSTGRES_USER=panshul_prod
POSTGRES_PASSWORD=replace-with-the-same-url-safe-hex-secret
DATABASE_URL=postgresql+asyncpg://panshul_prod:replace-with-the-same-url-safe-hex-secret@postgres:5432/panshul

REDIS_PASSWORD=replace-with-the-same-url-safe-hex-secret
REDIS_URL=redis://:replace-with-the-same-url-safe-hex-secret@redis:6379/0

QDRANT_IMAGE=qdrant/qdrant:replace-with-a-tested-pinned-version

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=qwen/qwen3-32b

STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
EMBEDDING_MODEL=BAAI/bge-m3
